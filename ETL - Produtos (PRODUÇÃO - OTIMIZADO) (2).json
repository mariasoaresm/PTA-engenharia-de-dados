    {
      "parameters": {
        "jsCode": "// 1. Pega o valor antigo da configuração\nconst last = parseInt($(\"Extrair ultima linha\").first().json.last || 0);\n\n// 2. Conta quantas linhas foram lidas DIRETAMENTE da tabela original\n// O nó \"2. Ler Tabela Pedidos\" tem a lista explodida (item por item)\nconst rows = $(\"2. Ler Tabela Produtos\").all().length; \n\n// 3. Calcula o novo total\n// Se last era 1 e leu 3095 linhas, o novo last será 3096\nconst newLast = last + rows;\n\nreturn [\n {\n json: {\n id: 1, // A Âncora para o Update\n last: newLast // O número correto da última linha\n }\n }\n];"
      },
