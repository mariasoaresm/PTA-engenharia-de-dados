    {
      "parameters": {
        "jsCode": "const response = items[0].json;\n\n// Tenta localizar a lista de produtos tratados\n// Verifica se está em data.products (padrão da sua API) ou na raiz\nlet listaProdutos = [];\n\nif (response.data && response.data.products) {\n    listaProdutos = response.data.products;\n} else if (response.products) {\n    listaProdutos = response.products;\n}\n\n// Retorna item por item para gravar no Sheets\nreturn listaProdutos.map(p => ({ json: p }));"
      },
      "id": "41834a11-7d9a-41bf-8aaa-3a0e4a9f015a",
      "name": "5. Code: Formata Resposta",
