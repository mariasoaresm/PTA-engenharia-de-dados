    {
      "parameters": {
        "jsCode": "// 2. Busca dados auxiliares (defensivo)\nconst orders = $items(\"Ler Orders\")?.map(i => i.json.order_id) || [];\nconst products = $items(\"Ler Products\")?.map(i => i.json.product_id) || [];\nconst sellers = $items(\"Ler Sellers\")?.map(i => i.json.seller_id) || [];\n\n// 3. Se alguma tabela não foi carregada → evitar crash\nif (orders.length === 0 || products.length === 0 || sellers.length === 0) {\n  return [{\n    json: {\n      error: \"missing_reference_tables\",\n      items: []\n    }\n  }];\n}\n\n// 4. Filtra corretamente\nconst itemsFull = items.map(i => i.json);\n\nconst filteredItems = itemsFull.filter(item =>\n  orders.includes(item.order_id) &&\n  products.includes(item.product_id) &&\n  sellers.includes(item.seller_id)\n);\n\n// 5. Retorno final\nreturn [{\n  json: {\n    orders: [],\n    products: [],\n    sellers: [],\n    items: filteredItems\n  }\n}];\n"
      },
