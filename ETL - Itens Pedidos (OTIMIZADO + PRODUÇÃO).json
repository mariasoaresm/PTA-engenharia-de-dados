      "parameters": {
        "jsCode": "// 1. Pega o valor antigo da configuração\nconst last = parseInt($(\"Extrair ultima linha\").first().json.last || 0);\n\n// 2. Conta quantas linhas foram lidas DIRETAMENTE da tabela original\n// Acessar via nome do node garante que pegamos o total lido, não importa o lote\nconst rows = $(\"Ler Tabela Itens\").all().length; \n\n// 3. Calcula o novo total\nconst newLast = last + rows;\n\nreturn [\n {\n json: {\n id: 1, \n last: newLast\n }\n }\n];"
      },
