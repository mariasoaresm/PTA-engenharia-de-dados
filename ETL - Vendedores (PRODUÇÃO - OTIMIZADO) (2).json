    {
      "parameters": {
        "jsCode": "// 1. Pega o corpo da resposta da API\nconst response = items[0].json;\n\n// 2. Tenta localizar a lista de vendedores tratados.\n// O código Python sugere que volta dentro de \"data.sellers\" ou na raiz \"sellers\".\n// Este código cobre as duas possibilidades para garantir.\nlet listaVendedores = [];\n\nif (response.data && response.data.sellers) {\n    listaVendedores = response.data.sellers;\n} else if (response.sellers) {\n    listaVendedores = response.sellers;\n}\n\n// 3. Retorna cada vendedor como um item individual para o n8n\n// Isso permite que o próximo nó (Google Sheets) grave linha por linha.\nreturn listaVendedores.map(vendedor => ({ json: vendedor }));"
      },
